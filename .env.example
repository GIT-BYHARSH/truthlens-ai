# TruthLens AI — environment template
# Copy to .env and fill in values. Never commit .env.

# Application
APP_NAME=TruthLens AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
# Comma-separated. For production add your Vercel URL, e.g.:
# CORS_ORIGINS=https://truthlens.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
# Local Docker: postgresql+asyncpg://truthlens:truthlens@localhost:5432/truthlens
# Neon (recommended if Docker unavailable): paste your Neon connection string
# Convert scheme to: postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://truthlens:truthlens@localhost:5432/truthlens

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Evidence retrieval (optional for early MVP; plug in when ready)
# Providers: none | serper | tavily
EVIDENCE_PROVIDER=none

SERPER_API_KEY=
TAVILY_API_KEY=
EVIDENCE_MAX_RESULTS=8

# Scoring weights (must sum conceptually; documented in docs/scoring.md)
CREDIBILITY_W_SUPPORT=0.30
CREDIBILITY_W_SOURCE=0.20
CREDIBILITY_W_AGREEMENT=0.15
CREDIBILITY_W_CONSISTENCY=0.10
CREDIBILITY_W_CONTRADICTION=0.15
CREDIBILITY_W_INSUFFICIENCY=0.10

CONFIDENCE_W_COVERAGE=0.30
CONFIDENCE_W_QUALITY=0.25
CONFIDENCE_W_MODEL=0.25
CONFIDENCE_W_CLARITY=0.10
CONFIDENCE_W_UNCERTAINTY=0.10

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
